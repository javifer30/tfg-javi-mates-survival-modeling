# Data from MIMIC-IV or derived patient-level files must not be versioned.
# Some files below are required at runtime but must be supplied manually after
# cloning, especially:
# - data/processed/mimic_extraction/flat_features.csv
# - data/processed/mimic_extraction/labels.csv
# - generated data/processed/static/*.parquet files when run_build_static_data
#   is false in configs/static_pipeline.yaml
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/mimic_extraction_explanation.md

# guidelines for the models
guidelines/
